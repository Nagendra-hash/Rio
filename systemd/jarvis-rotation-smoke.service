[Unit]
Description=JARVIS — post-rotation journald smoke check (❌ Recv / genai errors after GoAway)

[Service]
Type=oneshot
ExecStart=/home/nagendra/Mark-LIII/systemd/jarvis-rotation-smoke.sh
# Results land in /tmp/jarvis_rotation_smoke.log; a failed check leaves this
# unit "failed" until the next clean run — that is the alarm surface.
# Headless-safe: the script only reads journald, but DISPLAY keeps parity with
# the other JARVIS units in case a future tier needs it.
Environment=DISPLAY=:0
