[Unit]
Description=JARVIS — ngrok tunnel for TradingView alerts
# Exposes the local dashboard webhook (/api/tradingview, port 8000) to
# TradingView's cloud, which cannot reach 192.168.x.x LAN addresses.
# Runs tunnel_tv.sh (installs ngrok if missing, guards on the authtoken).
#
# Free-tier note: the public URL rotates on every restart of this unit —
# the current URL is written to memory/trading/tv_webhook_url.txt by
# tunnel_url.sh (ExecStartPost below) and printable with ./tunnel_url.sh.

[Service]
Type=exec
WorkingDirectory=%h/Mark-LIII
ExecStart=%h/Mark-LIII/tunnel_tv.sh
# Save the (rotating) public webhook URL after start. The '-' prefix makes
# failure NON-fatal: ngrok's handshake can outlast any sane poll window, and
# killing a healthy tunnel over a missed URL capture would be worse than a
# stale URL. The URL can always be re-captured with ./tunnel_url.sh --save.
ExecStartPost=-%h/Mark-LIII/tunnel_url.sh --save
Restart=on-failure
RestartSec=5
# ngrok logs to stdout/journal; keep a modest ceiling
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
