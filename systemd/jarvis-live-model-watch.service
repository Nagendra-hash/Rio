[Unit]
Description=JARVIS — probe failover Live model, flip back when recovered

[Service]
Type=oneshot
ExecStart=/home/nagendra/Mark-LIII/systemd/jarvis-live-model-watch.sh
# Results land in /tmp/jarvis_live_model_watch.log. A FAILED flip (rollback
# path) leaves this unit failed until the next clean run — the alarm surface,
# same convention as jarvis-rotation-smoke.service.
Environment=DISPLAY=:0
