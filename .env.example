# ── RIO/JARVIS environment variables ─────────────────────────────────────────
# Copy to `.env` (never commit it — real values live there, not in this file),
# then `source .env` before starting the app, OR set them in your shell.
#
# config/api_keys.json (gitignored) is the authoritative secret store of record
# for API keys; .env is the secondary, user-controlled override layer. Where
# both are set, the ENV VAR WINS (documented per-field below).

# ── NVIDIA NIM (PRIORITY 2 cloud provider, after the local model) ───────────
# Optional key: build.nvidia.com free dev tier (nvapi-… prefix).
NVIDIA_API_KEY=your_key_here

# Optional override for the hosted endpoint — the documented default is used
# when this is unset:
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# master switch for the provider (true/false); the provider still requires a key
NVIDIA_NIM_ENABLED=true

# ── FreeLLMAPI Gateway (multi-model aggregator) ─────────────────────────────
# The local FreeLLMAPI instance aggregates dozens of free-tier LLM providers
# behind one OpenAI-compatible endpoint. Rio routes through it automatically
# when the key is present.
FREELLMAPI_API_KEY=your_unified_freellmapi_key_here
FREELLMAPI_BASE_URL=http://localhost:3002/v1/chat/completions
FREELLMAPI_DEFAULT_MODEL=auto
FREELLMAPI_ENABLED=true

# ── Other knobs the router honors (existing behavior, documented here) ──────
# local | free | smart | gemini
JARVIS_ROUTER_MODE=smart

# pin a warm Ollama model in RAM instead of the 5-min default unload
#OLLAMA_KEEP_ALIVE_MINUTES=
